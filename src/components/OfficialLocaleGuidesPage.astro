---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsModule from './NewsModule.astro';
import FaqModule from './FaqModule.astro';
import { addedLocaleByCode, localePathForCode, type AddedLocale } from '../data/officialLocales';
import { officialLocaleGuidesV14, officialLocaleGuideUiV14 } from '../data/officialLocaleGuidesV14';

const { lang } = Astro.props as { lang:AddedLocale };
const profile = addedLocaleByCode[lang];
const copy = officialLocaleGuideUiV14[lang]!;
const pages = officialLocaleGuidesV14.filter(page => page.lang === lang);
const pathLang = localePathForCode(lang);
const path = `/${pathLang}/guides/`;
const groups = [...new Set(pages.map(page => page.label))].map(label => ({
  label, pages:pages.filter(page => page.label === label),
}));
const jsonLd = {'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:copy.hubTitle,description:copy.hubDescription,url:`https://controlresonant.wiki${path}`,inLanguage:lang,mainEntity:{'@type':'ItemList',numberOfItems:pages.length,itemListElement:pages.map((page,index)=>({'@type':'ListItem',position:index+1,name:page.title,url:`https://controlresonant.wiki/${pathLang}/${page.slug}/`}))}},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:copy.home,item:`https://controlresonant.wiki/${pathLang}/`},{'@type':'ListItem',position:2,name:copy.hubTitle,item:`https://controlresonant.wiki${path}`}]}
]};
const idFor = (label:string) => label.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\p{L}\p{N}]+/gu,'-').replace(/(^-|-$)/g,'');
---
<BaseLayout lang={lang} title={`${copy.hubTitle} | Field Guide`} description={copy.hubDescription} canonicalPath={path} jsonLd={jsonLd}>
  <section class="border-b border-ash-700">
    <div class="wrap py-14">
      <nav class="mb-5 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-ash-400" aria-label="Breadcrumb">
        <a href={`/${pathLang}/`} class="hover:text-bone">{copy.home}</a><span class="mx-2 text-ash-600">/</span>{copy.hubTitle}
      </nav>
      <p class="eyebrow">{copy.hubEyebrow}</p>
      <h1 class="mt-3 font-display text-3xl font-bold text-bone sm:text-4xl">{copy.hubTitle}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-bone-dim">{copy.hubIntro}</p>
    </div>
  </section>
  <div class="wrap py-12">
    <nav class="mb-12 border border-ash-700 bg-ash-900/30 p-5" aria-label={copy.browse}>
      <p class="eyebrow">{copy.browse}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {groups.map(group => <a href={`#${idFor(group.label)}`} class="border border-ash-700 px-3 py-2 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ash-300 transition-colors hover:border-resonant hover:text-bone">{group.label} · {group.pages.length}</a>)}
      </div>
    </nav>
    {groups.map(group => <section id={idFor(group.label)} class="mb-12 scroll-mt-24">
      <div class="mb-5 flex items-center gap-3"><h2 class="font-display text-xl font-bold text-bone">{group.label}</h2><span class="h-px flex-1 bg-ash-700"></span><span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-ash-500">{group.pages.length} {copy.files}</span></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {group.pages.map(page => <a href={`/${pathLang}/${page.slug}/`} class="group border border-ash-700 bg-ash-900/35 p-5 transition hover:border-resonant">
          <p class="eyebrow">{page.label}</p><h3 class="mt-2 font-display text-lg font-semibold text-bone group-hover:text-resonant">{page.title}</h3><p class="mt-3 text-sm leading-relaxed text-ash-300">{page.description}</p>
        </a>)}
      </div>
    </section>)}
  </div>
  <NewsModule tab="guides" lang={lang} />
  <FaqModule tab="guides" lang={lang} />
</BaseLayout>
