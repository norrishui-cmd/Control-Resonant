---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeHome, localizedPages } from '../../data/localized';
import { addedLocales, addedLocaleByPath, type LocaleProfile } from '../../data/officialLocales';

export function getStaticPaths() {
  return [
    ...(['de','fr'] as const).map(lang => ({ params:{lang}, props:{lang, profile:null} })),
    ...addedLocales.map(profile => ({ params:{lang:profile.path}, props:{lang:profile.code, profile} })),
  ];
}

const { lang, profile } = Astro.props as {lang:'de'|'fr'|string; profile:LocaleProfile|null};
const isLegacy = lang === 'de' || lang === 'fr';
const home = isLegacy ? localeHome[lang as 'de'|'fr'] : {
  title:profile!.title, description:profile!.description, label:profile!.label,
  heading:'CONTROL RESONANT', intro:profile!.intro, guides:profile!.guides,
  answer:profile!.answer, sourceNote:profile!.sourceNote,
};
const pageLang = isLegacy ? lang : profile!.code;
const pathLang = isLegacy ? lang : profile!.path;
const pages = isLegacy ? localizedPages.filter(p => p.lang === lang) : [];
const labels = lang === 'de'
  ? { release:'Erscheinungsdatum', sources:'Quellenstandard', browse:'Alle Themen öffnen', guides:'Lokalisierte Inhalte', database:'Spieldatenbank', databaseText:'23 geprüfte Datensätze zu Charakteren, Gegenständen, Gameplay, Gegnern und Demo-Status.', openDatabase:'Datenbank öffnen' }
  : lang === 'fr'
  ? { release:'Date de sortie', sources:'Méthode et sources', browse:'Explorer tous les sujets', guides:'Contenu localisé', database:'Base de données du jeu', databaseText:'23 entrées vérifiées sur les personnages, objets, systèmes, ennemis et le statut de la démo.', openDatabase:'Ouvrir la base' }
  : { release:profile!.nav.release, sources:'Official sources', browse:profile!.nav.guides, guides:profile!.guides, database:profile!.nav.database, databaseText:'47 verified records cover characters, equipment, gameplay systems, enemies and current demo status. The database remains available in English while deeper localization expands.', openDatabase:profile!.nav.database };
const firstHref = isLegacy ? `/${pathLang}/${pages[0].slug}/` : `/${pathLang}/language-support/`;
const jsonLd = {'@context':'https://schema.org','@type':'WebSite',name:home.title,url:`https://controlresonant.wiki/${pathLang}/`,inLanguage:pageLang};
---
<BaseLayout lang={pageLang} title={`${home.title} | Field Guide`} description={home.description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-ash-700"><div class="pointer-events-none absolute inset-y-0 left-0 w-1 bg-hiss"></div><div class="wrap py-16 sm:py-20">
    <p class="eyebrow">{home.label}</p><h1 class="mt-4 font-display text-4xl font-bold text-bone sm:text-6xl">{home.heading}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-bone-dim">{home.intro}</p>
    <div class="mt-8 flex flex-wrap gap-3"><a href={firstHref} class="bg-hiss px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[.14em] text-void">{isLegacy ? labels.release : profile!.nav.language} →</a><a href="#guides" class="border border-ash-600 px-5 py-3 font-mono text-xs uppercase tracking-[.14em] text-bone">{labels.browse}</a></div>
  </div></section>
  <section id="release" class="border-b border-ash-700 bg-ash-950/40"><div class="wrap py-8"><p class="max-w-4xl text-base leading-relaxed text-bone-dim"><strong class="text-bone">{lang === 'de' ? 'Kurzantwort: ' : lang === 'fr' ? 'Réponse courte : ' : `${profile!.shortLabel}: `}</strong>{home.answer}</p></div></section>
  <section id="guides" class="wrap py-16"><p class="eyebrow">{labels.guides}</p><h2 class="mt-2 font-display text-3xl font-bold text-bone">{home.guides}</h2>
    {isLegacy ? <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{pages.map(page => <a href={`/${pathLang}/${page.slug}/`} class="group border border-ash-700 bg-ash-900/35 p-5 transition hover:border-resonant"><p class="eyebrow">{page.label}</p><h3 class="mt-2 font-display text-lg font-semibold text-bone group-hover:text-resonant">{page.title}</h3><p class="mt-3 text-sm leading-relaxed text-ash-300">{page.description}</p></a>)}</div>
    : <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href={`/${pathLang}/language-support/`} class="group border border-ash-700 bg-ash-900/35 p-5 transition hover:border-resonant"><p class="eyebrow">{profile!.nav.language}</p><h3 class="mt-2 font-display text-lg font-semibold text-bone group-hover:text-resonant">{profile!.supportTitle}</h3><p class="mt-3 text-sm leading-relaxed text-ash-300">{profile!.supportDescription}</p></a>
        <a href="/release-date/" class="group border border-ash-700 bg-ash-900/35 p-5 transition hover:border-resonant"><p class="eyebrow">{profile!.nav.release}</p><h3 class="mt-2 font-display text-lg font-semibold text-bone group-hover:text-resonant">CONTROL Resonant — September 24, 2026</h3><p class="mt-3 text-sm leading-relaxed text-ash-300">Verified launch timing, platforms and edition details from Remedy and official stores.</p></a>
        <a href="/faq/" class="group border border-ash-700 bg-ash-900/35 p-5 transition hover:border-resonant"><p class="eyebrow">{profile!.nav.faq}</p><h3 class="mt-2 font-display text-lg font-semibold text-bone group-hover:text-resonant">50 verified player questions</h3><p class="mt-3 text-sm leading-relaxed text-ash-300">Direct answers with official sources and links to the relevant guide cluster.</p></a>
      </div>}
  </section>
  <section id="database" class="border-y border-ash-700 bg-ash-950/40"><div class="wrap py-12"><p class="eyebrow">FBC // Data</p><h2 class="mt-2 font-display text-2xl font-bold text-bone">{labels.database}</h2><p class="mt-3 max-w-2xl text-sm leading-relaxed text-bone-dim">{labels.databaseText}</p><a href={lang === 'de' ? '/de/datenbank/' : lang === 'fr' ? '/fr/base-de-donnees/' : '/database/'} class="mt-5 inline-flex border border-resonant px-4 py-3 font-mono text-xs uppercase tracking-[.14em] text-resonant hover:bg-resonant hover:text-void">{labels.openDatabase} →</a></div></section>
  <section id="platforms" class="wrap pb-16 pt-12"><div class="border border-ash-700 bg-ash-900/35 p-6"><h2 class="font-display text-xl font-bold text-bone">{labels.sources}</h2><p class="mt-3 max-w-3xl leading-relaxed text-bone-dim">{home.sourceNote}</p><a href="https://store.steampowered.com/app/3669870/CONTROL_Resonant/" rel="nofollow noopener" target="_blank" class="mt-4 inline-block font-mono text-xs uppercase tracking-[.14em] text-resonant hover:text-hiss">Steam official language matrix →</a></div></section>
</BaseLayout>
