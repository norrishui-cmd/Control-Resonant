---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedPages, pathFor } from '../../data/localized';
import NewsModule from '../../components/NewsModule.astro';
import FaqModule from '../../components/FaqModule.astro';
import { addedLocales, type LocaleProfile } from '../../data/officialLocales';
import { officialLocaleGuidesV14, officialLocaleGuideUiV14 } from '../../data/officialLocaleGuidesV14';
import type { OfficialLocaleGuide } from '../../data/officialLocaleGuidesV13';
export function getStaticPaths() {
  return [
    ...localizedPages.map(page => ({params:{lang:page.lang,slug:page.slug},props:{page,profile:null}})),
    ...addedLocales.map(profile => ({params:{lang:profile.path,slug:'language-support'},props:{page:null,profile}})),
    ...officialLocaleGuidesV14.map(page => {
      const profile = addedLocales.find(locale => locale.code === page.lang)!;
      return {params:{lang:profile.path,slug:page.slug},props:{page,profile}};
    }),
  ];
}
const props = Astro.props as { page:(OfficialLocaleGuide|any)|null; profile:LocaleProfile|null };
const isAdded = Boolean(props.profile);
const profile = props.profile;
const page = props.page ?? {
  lang:profile!.code,
  slug:'language-support',
  englishPath:'/guides/language-support/',
  title:profile!.supportTitle,
  description:profile!.supportDescription,
  label:profile!.nav.language,
  answer:profile!.answer,
  sections:[
    {heading:profile!.nav.language,paragraphs:[profile!.interfaceText]},
    {heading:profile!.fullAudio ? 'Full audio' : 'Audio status',paragraphs:[profile!.audioText]},
    {heading:profile!.nav.platforms,paragraphs:[profile!.platformText]},
  ],
  sources:[
    {label:'Steam — official language matrix',url:'https://store.steampowered.com/app/3669870/CONTROL_Resonant/'},
    {label:'CONTROL Resonant — official site',url:'https://controlgame.com/'},
  ],
};
const pathLang = isAdded ? profile!.path : page.lang;
const addedRelated = isAdded ? officialLocaleGuidesV14.filter(p => p.lang === page.lang && p.slug !== page.slug).slice(0,4) : [];
const related = isAdded ? [] : localizedPages.filter(p => p.lang === page.lang && p.slug !== page.slug && p.label === page.label).slice(0,4);
const fallbackRelated = isAdded ? addedRelated : (related.length ? related : localizedPages.filter(p => p.lang === page.lang && p.slug !== page.slug).slice(0,4));
const addedUi = isAdded ? officialLocaleGuideUiV14[profile!.code] : null;
const words = page.lang === 'de'
  ? {home:'Startseite', guides:'Guides', short:'Kurzantwort', sources:'Offizielle Quellen', related:'Verwandte Guides', updated:'Zuletzt geprüft am 26. Juli 2026', back:'Zurück zu allen Guides', note:'Details zu Control Resonant können sich vor Release ändern. Zeitkritische Angaben werden gegen offizielle Quellen geprüft.'}
  : page.lang === 'fr'
  ? {home:'Accueil', guides:'Guides', short:'Réponse courte', sources:'Sources officielles', related:'Guides associés', updated:'Dernière vérification le 26 juillet 2026', back:'Retour à tous les guides', note:'Les détails de Control Resonant peuvent évoluer avant la sortie. Les informations sensibles au temps sont vérifiées dans les sources officielles.'}
  : {home:profile!.nav.home, guides:profile!.nav.guides, short:addedUi?.short ?? profile!.shortLabel, sources:addedUi?.sources ?? 'Official sources', related:addedUi?.related ?? profile!.nav.guides, updated:addedUi?.updated ?? 'Official language matrix checked July 26, 2026', back:addedUi?.back ?? profile!.nav.home, note:addedUi?.note ?? profile!.sourceNote};
const canonicalPath = `/${pathLang}/${page.slug}/`;
const newsTab = page.englishPath === '/release-date/' ? 'release' : page.englishPath === '/guides/characters-and-story/' ? 'characters' : page.englishPath === '/guides/platforms-and-performance/' || page.englishPath === '/guides/system-requirements/' || page.englishPath === '/guides/language-support/' ? 'platforms' : page.englishPath === '/guides/combat-and-build-systems-explained/' ? 'guides' : null;
const jsonLd = {'@context':'https://schema.org','@graph':[{'@type':'Article',headline:page.title,description:page.description,inLanguage:page.lang,mainEntityOfPage:`https://controlresonant.wiki${canonicalPath}`},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:words.home,item:`https://controlresonant.wiki/${pathLang}/`},{'@type':'ListItem',position:2,name:page.title,item:`https://controlresonant.wiki${canonicalPath}`}]}]};
---
<BaseLayout lang={page.lang} title={`${page.title} | Field Guide`} description={page.description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <article><header class="border-b border-ash-700"><div class="wrap py-12"><nav class="mb-5 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-ash-400" aria-label="Breadcrumb"><a href={`/${pathLang}/`} class="hover:text-bone">{words.home}</a><span class="mx-2 text-ash-600">/</span><span>{words.guides}</span></nav><div class="mb-4 flex flex-wrap items-center gap-3"><span class="eyebrow">{page.label}</span><span class="stamp stamp--confirmed">{page.lang === 'de' ? 'Geprüft' : page.lang === 'fr' ? 'Vérifié' : addedUi?.verified ?? 'Verified'}</span></div><h1 class="max-w-3xl font-display text-3xl font-bold leading-tight text-bone sm:text-4xl">{page.title}</h1><p class="mt-4 max-w-2xl text-base leading-relaxed text-bone-dim">{page.description}</p><p class="mt-5 font-mono text-[.62rem] uppercase tracking-[.14em] text-ash-500">{words.updated}</p></div></header>
    <div class="wrap py-12"><div class="prose-doc"><section class="border-l-4 border-clearance bg-ash-900/50 p-5"><h2 class="!mt-0 !border-0 !p-0">{words.short}</h2><p class="!mb-0 mt-3">{page.answer}</p></section>
      {page.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(p => <p>{p}</p>)}{section.bullets && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}</section>)}
    </div>
    <aside class="mt-12 max-w-[44rem] border border-ash-700 bg-ash-900/40 p-5" aria-labelledby="sources-heading"><h2 id="sources-heading" class="font-display text-lg font-semibold text-bone">{words.sources}</h2><ul class="mt-3 space-y-2 text-sm text-bone-dim">{page.sources.map(s => <li><a href={s.url} rel="nofollow noopener" target="_blank" class="text-resonant hover:text-hiss">{s.label}</a></li>)}</ul></aside>
    <nav class="mt-10 max-w-[44rem]" aria-labelledby="related-heading"><h2 id="related-heading" class="font-display text-lg font-semibold text-bone">{words.related}</h2><ul class="mt-3 grid gap-2 sm:grid-cols-2">{isAdded && addedRelated.length ? addedRelated.map(p => <li><a href={`/${pathLang}/${p.slug}/`} class="block border border-ash-700 p-3 text-sm text-bone-dim transition-colors hover:border-resonant hover:text-bone">{p.title}</a></li>) : isAdded ? <><li><a href="/guides/language-support/" class="block border border-ash-700 p-3 text-sm text-bone-dim transition-colors hover:border-resonant hover:text-bone">All 15 official languages</a></li><li><a href="/guides/platforms-and-performance/" class="block border border-ash-700 p-3 text-sm text-bone-dim transition-colors hover:border-resonant hover:text-bone">{profile!.nav.platforms}</a></li><li><a href="/faq/" class="block border border-ash-700 p-3 text-sm text-bone-dim transition-colors hover:border-resonant hover:text-bone">{profile!.nav.faq}</a></li><li><a href="/news/" class="block border border-ash-700 p-3 text-sm text-bone-dim transition-colors hover:border-resonant hover:text-bone">News</a></li></> : fallbackRelated.map(p => <li><a href={pathFor(p,page.lang)} class="block border border-ash-700 p-3 text-sm text-bone-dim transition-colors hover:border-resonant hover:text-bone">{p.title}</a></li>)}</ul></nav>
    <div class="mt-12 max-w-[44rem] border-t border-ash-800 pt-6"><p class="text-xs leading-relaxed text-ash-400">{words.note}</p><a href={isAdded && addedUi ? `/${pathLang}/guides/` : isAdded ? `/${pathLang}/` : `/${page.lang}/guides/`} class="mt-4 inline-block font-mono text-xs uppercase tracking-[.16em] text-resonant hover:text-hiss">← {words.back}</a></div></div>
  </article>
  {newsTab && <NewsModule tab={newsTab} lang={page.lang} />}
  {newsTab && <FaqModule tab={newsTab} lang={page.lang} />}
</BaseLayout>
